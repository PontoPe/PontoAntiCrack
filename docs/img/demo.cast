[0.015911, "o", "\u001b[1mPontoAntiCrack — detection and remediation, replayed\u001b[0m\r\n\r\n\u001b[2m# Recorded in an isolated lab account. No AWS call is made by this demo.\u001b[0m\r\n\u001b[2m# Account IDs, ARNs and resource IDs are redacted.\u001b[0m\r\n\r\n"]
[0.043148, "o", "\u001b[1mPontoAntiCrack — detection and remediation, replayed\u001b[0m\r\n\r\n\u001b[2m# Recorded in an isolated lab account. No AWS call is made by this demo.\u001b[0m\r\n\u001b[2m# Account IDs, ARNs and resource IDs are redacted.\u001b[0m\r\n\r\n"]
[0.043198, "o", "\u001b[1m$ stratus detonate aws.exfiltration.ec2-security-group-open-port-22-ingress\u001b[0m\r\n  opened tcp/22 to 0.0.0.0/0 on sg-0123456789abcdef0\r\n\r\n\u001b[1m$ dry run first\u001b[0m\r\n\u001b[33mDRY_RUN\u001b[0m  would revoke tcp/22 from 0.0.0.0/0 — resource left unchanged\r\n\r\n"]
[0.043372, "o", "\u001b[1m$ live remediation\u001b[0m\r\n\u001b[32mAPPLIED\u001b[0m  revoked tcp/22 from 0.0.0.0/0\r\n         \u001b[1m5.97 s\u001b[0m from the attacker API call to the rule being gone\r\n         2 rules before, 1 revoked — tcp/443 left alone\r\n\r\n\u001b[1m$ seven world-open ports in eighty seconds\u001b[0m\r\n\u001b[31mBLOCKED\u001b[0m  circuit breaker held after 5 actions; 4 refusals recorded\r\n\r\n\u001b[1mA remediation that cannot stop is a weapon pointed at its own account.\u001b[0m\r\n"]
