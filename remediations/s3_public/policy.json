{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectBucketExposure",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketAcl",
        "s3:GetBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketTagging"
      ],
      "Resource": "arn:${partition}:s3:::*",
      "Condition": {
        "StringEquals": { "aws:ResourceAccount": "${account_id}" }
      }
    },
    {
      "Sid": "CloseBucketExposure",
      "Effect": "Allow",
      "Action": ["s3:PutBucketAcl", "s3:PutBucketPublicAccessBlock"],
      "Resource": "arn:${partition}:s3:::*",
      "Condition": {
        "StringEquals": { "aws:ResourceAccount": "${account_id}" }
      }
    },
    {
      "Sid": "NeverReadOrDestroyBucketContents",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:DeleteBucketPolicy",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutBucketLogging",
        "s3:PutBucketPolicy",
        "s3:PutBucketVersioning",
        "s3:PutLifecycleConfiguration",
        "s3:PutObject",
        "s3:PutReplicationConfiguration"
      ],
      "Resource": "*"
    }
  ]
}
